{
  "name": "ccee",
  "version": "0.1.0",
  "description": "기후변화와 환경생태",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "test": "node --test \"tests/*.test.js\"",
    "check:api": "node --env-file-if-exists=.env scripts/checkApi.js",
    "test:supabase": "node --use-env-proxy --env-file=.env src/testConnection.js",
    "demo": "node scripts/demo.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@supabase/supabase-js": "^2.117.2",
    "express": "^5.3.0"
  },
  "engines": {
    "node": ">=22.9"
  }
}
