# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 git에 올라가지 않습니다(.gitignore).
# 비밀 값(ANTHROPIC_API_KEY, SESSION_SECRET, ACCESS_CODE)은 채팅·이슈·커밋에 절대 붙여넣지 마세요.

# ---------- Anthropic ----------
ANTHROPIC_API_KEY=sk-ant-여기에_키
# 모델과 추론 강도. 비용과 응답 속도에 영향이 있어요. 모델을 바꾸면 npm run check:api 로 다시 점검하세요.
CHATBOT_MODEL=claude-opus-5-5
CHATBOT_EFFORT=medium

# ---------- 서버 ----------
PORT=3000
# 32자 이상 무작위 문자열. 만들기:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=여기에_32자_이상_무작위_문자열
# 학생에게만 알려 주는 수업 코드. 추측하기 어려운 8자 이상(영문+숫자)으로 정하고 수업마다 바꾸세요.
# 비우면 주소를 아는 누구나 쓸 수 있어요(서버가 시작할 때 경고합니다).
ACCESS_CODE=
# 호스팅 서비스 뒤에서 실행할 때 1 (그래야 학생별 요청 제한이 올바르게 동작해요)
# TRUST_PROXY=1
# 운영 서버에서는 production
# NODE_ENV=production

# ---------- 대화 기록(선택) ----------
# true로 바꾸기 전에 supabase/schema.sql 을 Supabase에서 실행하고, 학생·보호자 안내가 필요한지 학교에 확인하세요.
LOG_CHATS=false
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ---------- 학번으로 1차시 정리 카드 저장(선택, docs/DEPLOY.md 2-1) ----------
# true로 바꾸기 전에 supabase/schema.sql 을 실행하고, 학번을 저장해도 되는지 학교에 확인하세요.
SAVE_CARDS=false
# Supabase의 Settings > API Keys 에 있는 비밀 키(sb_secret_...). 모든 보안 규칙을 우회하는 키라서 서버에만 두세요.
SUPABASE_SECRET_KEY=

# ---------- 한도(선택, 기본값이 있어요. 의미는 docs/DEPLOY.md 3번) ----------
# DAILY_REQUEST_CAP=3000
# RATE_PER_SESSION_PER_MIN=8
# RATE_PER_IP_PER_MIN=240
# NEW_CONVERSATIONS_PER_IP_PER_MIN=60
# BAD_CODE_PER_IP_PER_MIN=30
# MAX_CONCURRENT_STREAMS=40
# MAX_TURNS=40
# MAX_STUDENT_CHARS=1000
# SESSION_MAX_AGE_HOURS=12
# CHATBOT_MAX_TOKENS=16000
# CARD_REQUESTS_PER_IP_PER_MIN=120
